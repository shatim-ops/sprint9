rtSize=14;jumpStyle=arc;jumpSize=16;rounded=0;labelBackgroundColor=#FFFFFF;strokeColor=#E8871E;dashed=1;dashPattern=8 8;" edge="1" parent="1" source="reports" target="kc"><mxGeometry width="240" relative="1" x="0.1" y="0" as="geometry"></mxGeometry></mxCell></object><object placeholders="1" c4Type="Relationship" c4Technology="SQL, read-only" c4Description="Строки витрины по user_login" label='&lt;div style="text-align: left"&gt;&lt;div style="text-align: center"&gt;&lt;b&gt;%c4Description%&lt;/b&gt;&lt;/div&gt;&lt;div style="text-align: center"&gt;[%c4Technology%]&lt;/div&gt;&lt;/div&gt;' id="rel18"><mxCell style="endArrow=blockThin;html=1;fontSize=10;fontColor=#404040;strokeWidth=1;endFill=1;elbow=vertical;metaEdit=1;endSize=14;startSize=14;jumpStyle=arc;jumpSize=16;rounded=0;labelBackgroundColor=#FFFFFF;strokeColor=#E8871E;" edge="1" parent="1" source="reports" target="ch"><mxGeometry width="240" relative="1" as="geometry"></mxGeometry></mxCell></object><object placeholders="1" c4Type="Relationship" c4Technology="SQL, без ФИО и контактов" c4Description="Срез клиентов и протезов" label='&lt;div style="text-align: left"&gt;&lt;div style="text-align: center"&gt;&lt;b&gt;%c4Description%&lt;/b&gt;&lt;/div&gt;&lt;div style="text-align: center"&gt;[%c4Technology%]&lt;/div&gt;&lt;/div&gt;' id="rel19"><mxCell style="endArrow=blockThin;html=1;fontSize=10;fontColor=#404040;strokeWidth=1;endFill=1;elbow=vertical;metaEdit=1;endSize=14;startSize=14;jumpStyle=arc;jumpSize=16;rounded=0;labelBackgroundColor=#FFFFFF;strokeColor=#E8871E;" edge="1" parent="1" source="airflow" target="crmdb"><mxGeometry width="240" relative="1" as="geometry"></mxGeometry></mxCell></object><object placeholders="1" c4Type="Relationship" c4Technology="SQL, серверный курсор" c4Description="События за новые дни и хвост в 2 дня" label='&lt;div style="text-align: left"&gt;&lt;div style="text-align: center"&gt;&lt;b&gt;%c4Description%&lt;/b&gt;&lt;/div&gt;&lt;div style="text-align: center"&gt;[%c4Technology%]&lt;/div&gt;&lt;/div&gt;' id="rel20"><mxCell style="endArrow=blockThin;html=1;fontSize=10;fontColor=#404040;strokeWidth=1;endFill=1;elbow=vertical;metaEdit=1;endSize=14;startSize=14;jumpStyle=arc;jumpSize=16;rounded=0;labelBackgroundColor=#FFFFFF;strokeColor=#E8871E;" edge="1" parent="1" source="airflow" target="db"><mxGeometry width="240" relative="1" x="0.1" y="0" as="geometry"></mxGeometry></mxCell></object><object placeholders="1" c4Type="Relationship" c4Technology="INSERT, DROP PARTITION" c4Description="Сырые события, витрина, etl_loads" label='&lt;div style="text-align: left"&gt;&lt;div style="text-align: center"&gt;&lt;b&gt;%c4Description%&lt;/b&gt;&lt;/div&gt;&lt;div style="text-align: center"&gt;[%c4Technology%]&lt;/div&gt;&lt;/div&gt;' id="rel21"><mxCell style="endArrow=blockThin;html=1;fontSize=10;fontColor=#404040;strokeWidth=1;endFill=1;elbow=vertical;metaEdit=1;endSize=14;startSize=14;jumpStyle=arc;jumpSize=16;rounded=0;labelBackgroundColor=#FFFFFF;strokeColor=#E8871E;" edge="1" parent="1" source="airflow" target="ch"><mxGeometry width="240" relative="1" x="-0.3" y="0" as="geometry"></mxGeometry></mxCell></object><mxCell id="legend" value="&lt;b&gt;Обозначения&lt;/b&gt;&lt;br&gt;Оранжевый контур и оранжевые связи: добавлено в этом задании&lt;br&gt;Пунктир: служебный запрос, не пользовательский поток" style="shape=note;whiteSpace=wrap;html=1;backgroundOutline=1;darkOpacity=0.05;size=14;align=left;verticalAlign=top;spacing=10;fontSize=11;fillColor=#FFF8E1;strokeColor=#C9B458;fontColor=#333333;" vertex="1" parent="1"><mxGeometry x="40" y="1120" width="540" height="70" as="geometry"/></mxCell><mxCell id="notes" value="&lt;b&gt;Как это работает&lt;/b&gt;&lt;br&gt;1. Airflow по расписанию 01:00 UTC забирает срез CRM и события телеметрии за ещё не обработанные сутки плюс два последних дня на случай досылки.&lt;br&gt;2. Агрегация по пользователю, протезу и дню считается внутри ClickHouse и пишется в витрину. Ключ сортировки начинается с user_login.&lt;br&gt;3. После сборки в etl_loads пишется дата, по которую витрина готова.&lt;br&gt;4. Сервис отчётов берёт логин только из токена, читает готовые строки витрины и обрезает период по etl_loads. Сложных расчётов в момент запроса нет.&lt;br&gt;5. PostgreSQL с телеметрией отчёты больше не нагружают." style="shape=note;whiteSpace=wrap;html=1;backgroundOutline=1;darkOpacity=0.05;size=14;align=left;verticalAlign=top;spacing=10;fontSize=11;fillColor=#FFF8E1;strokeColor=#C9B458;fontColor=#333333;" vertex="1" parent="1"><mxGeometry x="40" y="1210" width="540" height="190" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>