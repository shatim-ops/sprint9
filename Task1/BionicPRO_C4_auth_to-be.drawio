Size=16;rounded=0;labelBackgroundColor=#FFFFFF;strokeColor=#828282;dashed=1;dashPattern=8 8;" edge="1" parent="1" source="api" target="kc"><mxGeometry width="240" relative="1" x="0.44" y="0" as="geometry"></mxGeometry></mxCell></object><object placeholders="1" c4Type="Relationship" c4Technology="OIDC" c4Description="SSO для магазина и CRM" label='&lt;div style="text-align: left"&gt;&lt;div style="text-align: center"&gt;&lt;b&gt;%c4Description%&lt;/b&gt;&lt;/div&gt;&lt;div style="text-align: center"&gt;[%c4Technology%]&lt;/div&gt;&lt;/div&gt;' id="rel20"><mxCell style="endArrow=blockThin;html=1;fontSize=10;fontColor=#404040;strokeWidth=1;endFill=1;elbow=vertical;metaEdit=1;endSize=14;startSize=14;jumpStyle=arc;jumpSize=16;rounded=0;labelBackgroundColor=#FFFFFF;strokeColor=#E8871E;exitX=1;exitY=0.75;exitDx=0;exitDy=0;entryX=0.25;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="shop" target="kc"><mxGeometry width="240" relative="1" x="0.1" y="0" as="geometry"><Array as="points"><mxPoint x="1130" y="190"/><mxPoint x="1130" y="730"/><mxPoint x="1640" y="730"/></Array></mxGeometry></mxCell></object><object placeholders="1" c4Type="Relationship" c4Technology="" c4Description="" label='&lt;div style="text-align: left"&gt;&lt;div style="text-align: center"&gt;&lt;b&gt;%c4Description%&lt;/b&gt;&lt;/div&gt;&lt;/div&gt;' id="rel21"><mxCell style="endArrow=blockThin;html=1;fontSize=10;fontColor=#404040;strokeWidth=1;endFill=1;elbow=vertical;metaEdit=1;endSize=14;startSize=14;jumpStyle=arc;jumpSize=16;rounded=0;labelBackgroundColor=#FFFFFF;strokeColor=#E8871E;exitX=1;exitY=0.75;exitDx=0;exitDy=0;entryX=0.25;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="crm" target="kc"><mxGeometry width="240" relative="1" as="geometry"><Array as="points"><mxPoint x="1510" y="190"/><mxPoint x="1510" y="730"/><mxPoint x="1640" y="730"/></Array></mxGeometry></mxCell></object><object placeholders="1" c4Type="Relationship" c4Technology="LDAPS" c4Description="User Federation с каталогом страны N" label='&lt;div style="text-align: left"&gt;&lt;div style="text-align: center"&gt;&lt;b&gt;%c4Description%&lt;/b&gt;&lt;/div&gt;&lt;div style="text-align: center"&gt;[%c4Technology%]&lt;/div&gt;&lt;/div&gt;' id="rel22"><mxCell style="endArrow=blockThin;html=1;fontSize=10;fontColor=#404040;strokeWidth=1;endFill=1;elbow=vertical;metaEdit=1;endSize=14;startSize=14;jumpStyle=arc;jumpSize=16;rounded=0;labelBackgroundColor=#FFFFFF;strokeColor=#E8871E;exitX=0;exitY=0.75;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="kc" target="countryN"><mxGeometry width="240" relative="1" x="0.4" y="0" as="geometry"><Array as="points"><mxPoint x="1510" y="920"/></Array></mxGeometry></mxCell></object><object placeholders="1" c4Type="Relationship" c4Technology="OIDC / SAML" c4Description="Identity Brokering" label='&lt;div style="text-align: left"&gt;&lt;div style="text-align: center"&gt;&lt;b&gt;%c4Description%&lt;/b&gt;&lt;/div&gt;&lt;div style="text-align: center"&gt;[%c4Technology%]&lt;/div&gt;&lt;/div&gt;' id="rel23"><mxCell style="endArrow=blockThin;html=1;fontSize=10;fontColor=#404040;strokeWidth=1;endFill=1;elbow=vertical;metaEdit=1;endSize=14;startSize=14;jumpStyle=arc;jumpSize=16;rounded=0;labelBackgroundColor=#FFFFFF;strokeColor=#E8871E;" edge="1" parent="1" source="kc" target="idp_ru"><mxGeometry width="240" relative="1" as="geometry"></mxGeometry></mxCell></object><object placeholders="1" c4Type="Relationship" c4Technology="OIDC / SAML" c4Description="Identity Brokering" label='&lt;div style="text-align: left"&gt;&lt;div style="text-align: center"&gt;&lt;b&gt;%c4Description%&lt;/b&gt;&lt;/div&gt;&lt;div style="text-align: center"&gt;[%c4Technology%]&lt;/div&gt;&lt;/div&gt;' id="rel24"><mxCell style="endArrow=blockThin;html=1;fontSize=10;fontColor=#404040;strokeWidth=1;endFill=1;elbow=vertical;metaEdit=1;endSize=14;startSize=14;jumpStyle=arc;jumpSize=16;rounded=0;labelBackgroundColor=#FFFFFF;strokeColor=#E8871E;" edge="1" parent="1" source="kc" target="idp_other"><mxGeometry width="240" relative="1" as="geometry"></mxGeometry></mxCell></object><mxCell id="legend" value="&lt;b&gt;Обозначения&lt;/b&gt;&lt;br&gt;Оранжевый контур и оранжевые связи: новое или изменённое&lt;br&gt;Пунктир: служебный запрос, не пользовательский поток" style="shape=note;whiteSpace=wrap;html=1;backgroundOutline=1;darkOpacity=0.05;size=14;align=left;verticalAlign=top;spacing=10;fontSize=11;fillColor=#FFF8E1;strokeColor=#C9B458;fontColor=#333333;" vertex="1" parent="1"><mxGeometry x="40" y="1050" width="540" height="70" as="geometry"/></mxCell><mxCell id="notes" value="&lt;b&gt;Ключевые решения&lt;/b&gt;&lt;br&gt;1. Фронтенды не видят токены IdP. Логин идёт через BFF, токены лежат в Redis, клиенту уходит только непрозрачный идентификатор сессии.&lt;br&gt;2. BFF как confidential client использует Code Grant + PKCE, refresh-токены ротируются, session id меняется после логина.&lt;br&gt;3. Учётные записи живут в каталоге страны. Keycloak ходит в него через User Federation с выключенным импортом и у себя пользователей не хранит.&lt;br&gt;4. На каждую страну свой realm: свой каталог, свои внешние IdP, свои требования к паролям и MFA.&lt;br&gt;5. В токенах нет ПДн: sub, роли, страна. Остальное API берёт из базы своей страны." style="shape=note;whiteSpace=wrap;html=1;backgroundOutline=1;darkOpacity=0.05;size=14;align=left;verticalAlign=top;spacing=10;fontSize=11;fillColor=#FFF8E1;strokeColor=#C9B458;fontColor=#333333;" vertex="1" parent="1"><mxGeometry x="40" y="1140" width="540" height="170" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>